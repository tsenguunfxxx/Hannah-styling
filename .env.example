# ---------------------------------------------------------
# .env файлаа ҮҮНЭЭС хуулж үүсгэнэ:  cp .env.example .env
# .env файлыг git дээр ХЭЗЭЭ Ч оруулахгүй.
# ---------------------------------------------------------

# Neon PostgreSQL (PHASE 2)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js (PHASE 4) — түлхүүр үүсгэх:  npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary — барааны зураг (PHASE 11)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Сайтын хаяг
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------
# НУУЦ ҮГ СЭРГЭЭХ — код илгээх
# Аль нэгийг нь ч тохируулаагүй бол код зөвхөн terminal дээр
# хэвлэгдэнэ (хөгжүүлэлтэд ажиллана, бодит хэрэглэгчид очихгүй).
# ---------------------------------------------------------

# --- ИМЭЙЛ ---
# "gmail" эсвэл "resend". Хоосон бол имэйл илгээхгүй.
EMAIL_PROVIDER=""
EMAIL_FROM_NAME="HANNAH"

# Gmail ашиглах бол (үнэгүй, өдөрт ~500 захидал):
#   1. Google Account → Security → 2-Step Verification-ийг АСААНА
#   2. myaccount.google.com/apppasswords → шинэ "App password" үүсгэнэ
#   3. Гарч ирсэн 16 тэмдэгтийг доор тавина (жирийн нууц үг АЖИЛЛАХГҮЙ)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Resend ашиглах бол (resend.com — домэйноо баталгаажуулах шаардлагатай):
RESEND_API_KEY=""
EMAIL_FROM=""

# --- SMS ---
# "twilio" эсвэл "custom". Хоосон бол SMS илгээхгүй.
SMS_PROVIDER=""

# Twilio (олон улсын, шууд ажиллана):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Монгол gateway (messagepro.mn, sms.mn г.м) — JSON POST хийнэ.
# Талбарын нэрийг gateway-ийн бичиг баримтаас хараад тохируулна.
SMS_API_URL=""
SMS_API_KEY=""
SMS_FIELD_TO="to"
SMS_FIELD_TEXT="text"

# ---------------------------------------------------------
# WIRE.MN — төлбөрийн gateway (docs.wire.mn)
# app.wire.mn дээр бүртгүүлж, KYC баталгаажуулаад,
# банкны дансаа холбосны дараа түлхүүрээ авна.
#
# sk_test_... = туршилт (мөнгө хөдлөхгүй)
# sk_live_... = бодит
#
# Хоосон бол Wire сонголт туршилтын горимд ажиллана.
# ---------------------------------------------------------
WIRE_SECRET_KEY=""

# Webhook нууц түлхүүр (whsec_...).
# app.wire.mn → Webhooks → шинэ endpoint үүсгэхэд гарч ирнэ.
# Endpoint хаяг: https://таны-домэйн/api/payment/wire/callback
WIRE_WEBHOOK_SECRET=""
