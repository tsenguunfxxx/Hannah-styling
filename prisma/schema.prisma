// ============================================================
// HANNAH STYLE — Database schema
// Өөрчлөлт хийсний дараа:  npm run db:push && npm run db:generate
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUM — зөвшөөрөгдсөн утгуудын жагсаалт
// String биш enum ашигласнаар алдаа бичих боломжгүй болно
// ------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // Хүлээгдэж байна
  CONFIRMED // Баталгаажсан
  PROCESSING // Бэлтгэж байна
  SHIPPED // Хүргэлтэнд гарсан
  DELIVERED // Хүргэгдсэн
  CANCELLED // Цуцлагдсан
}

enum PaymentMethod {
  /// ХУУЧИРСАН — 2026-09-д хассан. Шинэ захиалгад сонгогдохгүй
  /// (lib/constants.ts дотор байхгүй). Хуучин захиалгууд ашигласаар
  /// байгаа тул enum-аас БҮРМӨСӨН хасч болохгүй.
  QPAY
  WIRE // wire.mn — банкны апп, хэтэвч, QR-ыг нэг дор
  BANK_TRANSFER
  COD // Хүргэлтээр төлөх
}

enum PaymentStatus {
  PENDING // Төлөгдөөгүй
  PAID // Төлөгдсөн
  FAILED // Амжилтгүй
  REFUNDED // Буцаагдсан
}

enum CouponType {
  PERCENT // Хувиар: 10 = 10%
  FIXED // Тогтмол дүнгээр: 10000 = 10,000₮
}

enum ResetChannel {
  EMAIL // Имэйлээр код авах
  PHONE // Утсаар (SMS) код авах
}

// ------------------------------------------------------------
// ХЭРЭГЛЭГЧ
// ------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Hash хийсэн нууц үг. Google-ээр нэвтэрсэн хэрэглэгчид энэ хоосон байна.
  password      String?
  // Утсаар нэвтрэх боломжтой тул ДАВХАРДАХГҮЙ байх ёстой.
  // Хоосон (null) утга олон байж болно — Postgres NULL-ыг давхардал гэж үзэхгүй.
  phone         String?   @unique
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart?
  wishlist  Wishlist?

  @@index([role])
}

/// Auth.js-д шаардлагатай — Google, GitHub зэрэг гадаад бүртгэл
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js-д шаардлагатай — нэвтэрсэн session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js-д шаардлагатай — email баталгаажуулах / нууц үг сэргээх код
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Нууц үг сэргээх 6 оронтой код.
///
/// Кодыг ЗАДГАЙГААР хадгалахгүй — bcrypt-ээр hash хийнэ.
/// Ингэснээр өгөгдлийн сан задарсан ч кодыг ашиглаж чадахгүй.
model PasswordResetCode {
  id String @id @default(cuid())

  /// Имэйл хаяг эсвэл 8 оронтой утасны дугаар
  identifier String
  channel    ResetChannel

  codeHash String
  expires  DateTime

  /// Хэдэн удаа буруу оруулсан — 5-аас хэтэрвэл код хүчингүй болно
  attempts Int @default(0)

  /// Нэг код зөвхөн НЭГ удаа ажиллана
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([identifier])
  @@index([expires])
}

/// Хэрэглэгчийн хадгалсан хүргэлтийн хаяг
model Address {
  id            String  @id @default(cuid())
  userId        String
  label         String? // "Гэр", "Ажил"
  recipientName String
  phone         String
  city          String  @default("Улаанбаатар")
  district      String // Дүүрэг
  addressLine   String // Хороо, байр, тоот
  note          String?
  isDefault     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------------
// БАРАА
// ------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // URL-д ашиглана: /shop?category=camts
  description String?
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  // Өөртөө холбогдсон: "Эмэгтэй" → "Даашинз"
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String // Богино танилцуулга
  details     String? // Материал, арчилгаа — дэлгэрэнгүй таб

  // Үнийг ТӨГРӨГӨӨР, бүхэл тоогоор хадгална.
  // Float ашиглавал 0.1 + 0.2 = 0.30000000000000004 гэсэн алдаа мөнгөнд гарна.
  basePrice     Int
  discountPrice Int? // Хямдралтай үнэ. Хоосон бол хямдрал байхгүй

  /// Эцсийн үнэ = discountPrice ?? basePrice.
  /// Яагаад давхар хадгалав? Үнээр шүүх, эрэмбэлэхэд database хоёр талбарыг
  /// зэрэг харьцуулж чадахгүй. Тиймээс бодоод бэлэн хадгална.
  /// Бараа хадгалах бүрд ЗААВАЛ шинэчилнэ (actions/admin/product.action.ts).
  effectivePrice Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  isActive   Boolean @default(true) // false = дэлгүүрт харагдахгүй
  isFeatured Boolean @default(false) // Онцлох collection-д гарна
  soldCount  Int     @default(0) // "Хамгийн их зарагдсан" эрэмбэд

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([effectivePrice])
  @@index([createdAt])
  @@index([soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String? // Cloudinary-гаас устгахад хэрэгтэй
  alt       String?
  sortOrder Int     @default(0) // 0 = үндсэн зураг, 1 = hover зураг

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Өнгө + размерын хослол бүр. ЖИНХЭНЭ зарагдах нэгж.
/// Жишээ: Black / M / 15 ширхэг
model ProductVariant {
  id        String @id @default(cuid())
  productId String

  size     String // "S" | "M" | "L" | "XL"
  color    String // "Black"
  colorHex String  @default("#000000") // Дугуй өнгө харуулахад
  sku      String? @unique // Агуулахын код

  stock Int  @default(0)
  price Int? // Хоосон бол product.basePrice-ийг ашиглана

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Нэг бараанд "Black / M" ганц л удаа байна
  @@unique([productId, size, color])
  @@index([productId])
}

// ------------------------------------------------------------
// САГС
// ------------------------------------------------------------

/// Нэвтэрсэн хэрэглэгчид userId, зочинд sessionId (cookie) байна
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Нэг сагсанд ижил variant давхардахгүй — тоо нь нэмэгдэнэ
  @@unique([cartId, variantId])
  @@index([cartId])
}

// ------------------------------------------------------------
// ХҮСЛИЙН ЖАГСААЛТ
// ------------------------------------------------------------

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// ------------------------------------------------------------
// ЗАХИАЛГА
// ------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // Хүнд харуулах дугаар: HN-250824-0001

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  // Мөнгөн дүнгүүд — захиалга үүсэх үед тооцоолж хөлдөөнө
  subtotal    Int // Барааны нийт үнэ
  shippingFee Int @default(0)
  discount    Int @default(0)
  total       Int // subtotal + shippingFee - discount

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // Хүргэлтийн мэдээллийг ХУУЛЖ хадгална.
  // Хэрэглэгч дараа нь хаягаа өөрчилсөн ч хуучин захиалга хэвээрээ.
  customerName String
  phone        String
  email        String?
  city         String  @default("Улаанбаатар")
  district     String
  addressLine  String
  note         String?

  // Цуцлахад үлдэгдлийг ДАВХАР буцаахаас сэргийлнэ
  stockRestored Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Захиалгын нэг мөр.
/// ЧУХАЛ: барааны нэр, үнэ, зургийг захиалах үед ХУУЛЖ авна.
/// Ингэснээр маргааш үнэ өөрчлөгдөхөд хуучин захиалга хөдлөхгүй.
model OrderItem {
  id      String @id @default(cuid())
  orderId String

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // --- Захиалах үеийн хуулбар (snapshot) ---
  productName String
  productSlug String
  image       String?
  size        String
  color       String
  unitPrice   Int // Тухайн үеийн нэгжийн үнэ
  quantity    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Int

  transactionId String? // Банкны гүйлгээний дугаар
  /// ХУУЧИРСАН — QPay хассан. Бүх мөрөнд хоосон байгаа тул
  /// дараагийн deploy-ийн дараа устгаж болно.
  qpayInvoiceId String?

  /// wire.mn-ий PaymentIntent (pi_...). Төлбөр төлөгдсөн эсэхийг
  /// дараа нь ЭНЭ дугаараар шалгана.
  wireIntentId String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ------------------------------------------------------------
// СЭТГЭГДЭЛ, ХӨНГӨЛӨЛТ
// ------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Нэг хэрэглэгч нэг бараанд нэг л сэтгэгдэл
  @@unique([productId, userId])
  @@index([productId])
}

model Coupon {
  id    String     @id @default(cuid())
  code  String     @unique // "WELCOME10"
  type  CouponType @default(PERCENT)
  value Int // PERCENT бол 10 = 10%, FIXED бол 10000 = 10,000₮

  minOrder  Int? // Хамгийн багадаа энэ дүнгээс дээш захиалгад
  maxUses   Int? // Нийт хэдэн удаа ашиглаж болох
  usedCount Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  orders Order[]

  @@index([code])
}

/// Newsletter-т бүртгүүлсэн имэйлүүд
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
